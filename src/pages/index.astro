---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white text-2xl tracking-tight">
      Vignesh Rajendran
    </h1>
    <p class="animate mt-2 text-black/70 dark:text-white/70">
      Product founder. Building AI agents that businesses trust on WhatsApp.
    </p>

    <div class="space-y-16 mt-10">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I'm co-founder at <Link href="https://trypeach.ai" external>Peach</Link>,
            where we help companies run customer conversations on WhatsApp — including
            AI agents that answer, act, and hand off to humans when they shouldn't guess.
          </p>
          <p class="animate">
            I care about the product problems most agent demos skip: who owns the chat after
            escalate, what happens on a webhook retry, why “latency” is often a queue, and
            how memory fails as either amnesia or hallucination. I write from shipping those
            systems — not from slide decks.
          </p>
          <p class="animate">
            Open to product roles on AI agents, applied AI, and conversational platforms —
            especially teams that treat reliability and handoff as first-class product.
          </p>
        </article>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Focus
        </h2>
        <ul class="list-disc pl-5 space-y-2 marker:text-black/30 dark:marker:text-white/30">
          <li>Agent ↔ human boundary: escalate, hybrid, and override as product modes</li>
          <li>Reliability under retries: tools that don't double-charge the customer</li>
          <li>Chat latency budgets: interactive SLA vs broadcast throughput</li>
          <li>Context &amp; memory: what the model may remember vs invent</li>
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Writing
          </h2>
          <Link href="/blog">
            See all
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Work
          </h2>
          <Link href="/work">
            See all
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Contact
        </h2>
        <article>
          <p>
            If you're hiring for AI product roles, or want to talk agents that don't
            embarrass you in production — reach out.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              email
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
