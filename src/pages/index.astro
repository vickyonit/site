---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => (b.data.date?.valueOf() ?? Number.MAX_SAFE_INTEGER) - (a.data.date?.valueOf() ?? Number.MAX_SAFE_INTEGER) || b.slug.localeCompare(a.slug))
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const allwork = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white text-2xl tracking-tight">
      Vignesh Rajendran
    </h1>
    <p class="animate mt-2 text-black/70 dark:text-white/70">
      Co-founder at Peach. Building Dexy since January 2025. Bengaluru.
    </p>

    <div class="space-y-16 mt-10">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I co-founded <Link href="https://trypeach.ai" external>Peach</Link>, a WhatsApp
            platform for business conversations, automations and AI agents. Since
            mid-2025 I've been building the agents, with a person stepping in when they
            should. I own the architecture, the infrastructure and the agent runtime.
          </p>
          <p class="animate">
            In January 2025 I started <strong class="text-black dark:text-white font-semibold">Dexy</strong>,
            a separate product: an AI workspace runtime with playbooks, MCP in both directions,
            a sandbox and long agent loops. Peach is the messaging plane and Dexy is the
            workspace runtime. They meet at Streams and MCP.
          </p>
          <p class="animate">
            Before that I co-founded Gumstack, a video shopping widget used by retailers like
            Urban Ladder and Furlenco, and was a founding member of InterviewPass. Earlier I
            worked on product and growth at Recruiterbox and built web and mobile
            applications at TCS. Writing here is notes from those codebases. If it reads
            like a generic AI essay, I failed.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Writing
          </h2>
          <Link href="/blog">
            See all
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Work
          </h2>
          <Link href="/work">
            See all
          </Link>
        </div>
        <ul class="flex flex-col space-y-4">
          {work.map(entry => (
            <li>
              <div class="text-sm opacity-75">
                {dateRange(entry.data.dateStart, entry.data.dateEnd)}
              </div>
              <div class="font-semibold text-black dark:text-white">
                {entry.data.company}
              </div>
              <div class="text-sm opacity-75">
                {entry.data.role}
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Contact
        </h2>
        <article>
          <p>
            Email or LinkedIn if you want to talk about running AI agents in production.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              email
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
