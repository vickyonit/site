---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { getAllSeries } from "@lib/series";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(p => !p.data.draft);
  const seriesList = getAllSeries(posts);

  return seriesList.map((series) => ({
    params: { id: series.id },
    props: { series },
  }));
}

const { series } = Astro.props;
---

<PageLayout
  title={`${series.title} (Series)`}
  description={`A complete 9-part engineering curriculum: ${series.title}`}
>
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>

    <div class="space-y-4 my-10 animate">
      <div class="flex items-center gap-2">
        <span class="text-[10px] uppercase font-semibold tracking-wider px-2 py-0.5 rounded border border-black/15 dark:border-white/20 bg-black/5 dark:bg-white/5 text-black/80 dark:text-white/80">
          Series Curriculum
        </span>
        <span class="text-xs text-black/60 dark:text-white/60">
          {series.totalParts} Parts
        </span>
      </div>

      <h1 class="text-2xl font-semibold text-black dark:text-white tracking-tight">
        {series.title}
      </h1>

      <p class="text-sm text-black/70 dark:text-white/70 max-w-2xl leading-relaxed">
        Building a production-ready, zero-dependency customer support agent from first principles in pure Python.
        We cover strict conversational turn invariants, zero-trust authentication middleware, local markdown RAG,
        event-driven lifecycle buses, OpenTelemetry GenAI tracing, cache-aware context compaction, and hardened Docker deployment.
      </p>

      <div class="pt-2 flex flex-wrap items-center gap-3">
        <a
          href={`/blog/${series.firstPost.slug}`}
          class="px-4 py-2 text-xs font-semibold rounded-lg bg-black text-white dark:bg-white dark:text-black hover:opacity-90 transition-opacity"
        >
          Start Reading (Part 0 &rarr;)
        </a>
        <a
          href="https://github.com/vickyonit/agent-harness"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-xs font-medium rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
        >
          GitHub Repository &rarr;
        </a>
      </div>
    </div>

    <section class="space-y-4 my-12 animate">
      <div class="font-semibold text-black dark:text-white">
        Curriculum Roadmap
      </div>
      <ul class="flex flex-col gap-3">
        {series.posts.map((post) => (
          <li>
            <ArrowCard entry={post as any} />
          </li>
        ))}
      </ul>
    </section>
  </Container>
</PageLayout>
