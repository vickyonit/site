---
import type { SeriesNavInfo } from "@lib/series";

interface Props {
  seriesNav: SeriesNavInfo;
  currentSlug: string;
}

const { seriesNav, currentSlug } = Astro.props;
---

<div class="my-6 p-4 rounded-lg border border-black/15 dark:border-white/20 bg-black/[0.03] dark:bg-white/[0.03]">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-[10px] uppercase font-semibold tracking-wider px-2 py-0.5 rounded border border-black/15 dark:border-white/20 bg-black/5 dark:bg-white/5 text-black/80 dark:text-white/80">
        Series
      </span>
      <span class="text-xs text-black/60 dark:text-white/60">
        Part {seriesNav.currentPart} of {seriesNav.totalParts - 1}
      </span>
    </div>
    <a
      href={`/blog/series/${seriesNav.seriesId}`}
      class="text-xs text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white underline underline-offset-2 transition-colors"
    >
      Series overview &rarr;
    </a>
  </div>

  <div class="mt-2 font-medium text-sm text-black dark:text-white">
    {seriesNav.seriesTitle}
  </div>

  <details class="group mt-3 pt-3 border-t border-black/10 dark:border-white/10 text-xs">
    <summary class="cursor-pointer font-medium text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white flex items-center justify-between transition-colors">
      <span>All {seriesNav.totalParts} parts in this series</span>
      <span class="text-[11px] opacity-60 group-open:rotate-180 transition-transform">&darr;</span>
    </summary>
    <ol class="mt-3 space-y-1.5 pl-2">
      {seriesNav.seriesPosts.map((p) => {
        const isCurrent = p.slug === currentSlug;
        return (
          <li class="flex items-start gap-2">
            <span class="font-mono text-[11px] text-black/40 dark:text-white/40 min-w-[3.5rem]">
              Part {p.data.series?.part}:
            </span>
            {isCurrent ? (
              <span class="font-semibold text-black dark:text-white">
                {p.data.title} <span class="text-[10px] uppercase tracking-wide opacity-60">(current)</span>
              </span>
            ) : (
              <a
                href={`/blog/${p.slug}`}
                class="text-black/70 dark:text-white/70 hover:text-black dark:hover:text-white underline underline-offset-2 transition-colors"
              >
                {p.data.title}
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </details>
</div>
